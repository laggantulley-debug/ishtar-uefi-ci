#!/bin/bash
# clang wrapper for cross-building XNU on Linux:
#  - forces an Apple Mach-O target (stock Linux clang defaults to ELF)
#  - drops flags only Apple's clang understands
#  - links with the cctools ld64
HB="$(cd "$(dirname "$0")" && pwd)"
case "$(basename "$0")" in *++) drv=clang++; extra=(-fno-use-cxa-atexit);; *) drv=clang; extra=();; esac
args=()
for a in "$@"; do
  case "$a" in
    -enable-trivial-auto-var-init-zero-knowing-it-will-be-removed-from-clang) ;;
    -fapple-kext-vtable-verify|-Wno-vla-cxx-extension) ;;
    # Arm SME 相关开关只有较新的 Apple clang 认识；Ubuntu 24.04 的 clang-18 会报
    # "unknown argument: '-mno-implicit-sme'"（MakeInc.def:473 给 arm64 内核加的）。
    -mno-implicit-sme|-mimplicit-sme|-msme|-mno-sme) ;;
    -Werror|-Werror=*|-Weverything|-pedantic-errors) ;;
    *) args+=("$a");;
  esac
done
# 指针认证的寄存器（APIAKeyLo_EL1 / APGAKeyLo_EL1）要 arm64 后端带 pauth 特性才被汇编器认；
# 不带就报 "expected readable system register"（osfmk/arm64/sleh.c、arm64/start.s）。
# 基线保持 armv8-a（A53 没有 LSE，-march=armv8.3-a 会让编译器发 ldadd 之类），只加 pauth。
exec /usr/bin/$drv -include "$HB/../../hostinc/xnu_clang_compat.h" -target arm64-apple-ios${XNU_SDK_VERSION:-16.5} \
  -march=${XNU_MARCH:-armv8-a+pauth} --ld-path="$HB/ld64" \
  -w "${extra[@]}" "${args[@]}"
